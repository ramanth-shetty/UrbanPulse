# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
/dist

# Environment variables & secrets (CRITICAL: Never commit API keys)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Allow example env files to be tracked
!.env.example
!.env.local.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor folders
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Antigravity / Gemini Workspace Cache
.gemini/
